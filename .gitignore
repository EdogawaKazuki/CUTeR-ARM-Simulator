# macOS
.DS_Store

# Unity generated/local folders
# Matches Unity projects directly under /Source, e.g.
# /Source/CUTeR Arm Simulator v2/
# /Source/CUTeR Virtual Environment Builder/
/Source/*/[Ll]ibrary/
/Source/*/[Tt]emp/
/Source/*/[Oo]bj/
/Source/*/[Bb]uild/
/Source/*/[Bb]uilds/
/Source/*/[Ll]ogs/
/Source/*/[Uu]ser[Ss]ettings/

# Unity / IDE generated files
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.tmp

# Build artifacts
*.apk

# IDE folders
.vs/
.idea/